# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted (required after deployment).
# Example: https://your-app-xxxxx.run.app
# Used for order tracking links in notifications.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Security — JWT & Admin Auth
# ---------------------------------------------------------------------------
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="YOUR_STRONG_RANDOM_JWT_SECRET_MIN_64_CHARS"

# Admin portal credentials (used to seed Supabase and local admin_config.json)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="YOUR_STRONG_ADMIN_PASSWORD"

# ---------------------------------------------------------------------------
# Supabase Database
# ---------------------------------------------------------------------------
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# ---------------------------------------------------------------------------
# Razorpay Payment Gateway
# ---------------------------------------------------------------------------
# Get your keys from: https://dashboard.razorpay.com/app/keys
# Use rzp_test_ keys for testing, rzp_live_ keys for production.
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_SECRET"

# This key is exposed to the frontend. Only expose the Key ID, never the secret.
VITE_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# Set to "true" to send real email OTPs and production notifications.
# When "false", OTP codes are generated but shown in the API response for testing.
ENABLE_REAL_NOTIFICATIONS="false"

# Twilio credentials — get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Your Twilio phone number in E.164 format (must support SMS to India).
# Example: +15017122661
TWILIO_SMS_NUMBER=""

# Optional: WhatsApp sender for order alerts (Twilio WhatsApp sandbox or approved sender).
# Example: whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=""

# ---------------------------------------------------------------------------
# Email (SMTP) - required for live email OTP and optional order booking emails
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Meris E-Shop"
SMTP_FROM_EMAIL=""

