# =============================================================================
# RADHA FASHIONS — Environment Variables
#
# This app runs unchanged on Cloudflare Workers, Railway, Render and Vercel.
# The same variable names are used everywhere; only the place you set them
# differs.
#
#   Local Node ....... .env (copy this file and fill it in)
#   Cloudflare local .. .dev.vars  (wrangler dev reads this instead of .env)
#   Cloudflare prod ... Dashboard ▸ Settings ▸ Variables and Secrets
#                       — non-secret values as Variables
#                       — everything below marked SECRET as a Secret
#                       (or `npx wrangler secret put <NAME>` from the CLI)
#   Railway / Render .. service Environment Variables
#
# NEVER commit .env or .dev.vars to git.
#
# NOTE: the Cloudflare dashboard refuses to save variables on a Worker that
# only has static assets. This project ships worker.ts as its entry point, so
# the Worker is a real Worker and variables are accepted.
#
# See CLOUDFLARE.md for the full deployment runbook.
# =============================================================================

# ---------------------------------------------------------------------------
# App URL (REQUIRED in production)
# ---------------------------------------------------------------------------
# Your live origin. Used for CORS, email links, OTP emails and order tracking.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Clerk social sign-in (optional)
# ---------------------------------------------------------------------------
# Build-time value — on Cloudflare this is a build environment variable, not a
# Worker secret. Do not use a placeholder or a deactivated key: the storefront
# remains fully available without it through password and email-OTP sign-in.
VITE_CLERK_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------------
# Security — JWT & Admin Auth (REQUIRED, SECRET)
# ---------------------------------------------------------------------------
# Generate a strong random secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# Cloudflare: npx wrangler secret put JWT_SECRET
# Without it the server generates a random secret on boot, which invalidates
# every existing admin session cookie on each deploy.
JWT_SECRET="YOUR_STRONG_RANDOM_JWT_SECRET_MIN_64_CHARS"

# Admin portal bootstrap credentials (SECRET).
# After the first successful deploy these live in the Supabase `admin_config`
# table and can be changed from the admin panel. These values are only the
# fallback used when that table is empty.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="YOUR_STRONG_ADMIN_PASSWORD"

# ---------------------------------------------------------------------------
# Supabase Database (REQUIRED, SECRET) — the only persistent database
# ---------------------------------------------------------------------------
# Get from: https://supabase.com/dashboard → Project Settings → API
# Use the SERVICE ROLE key (not the anon key) — RLS is enabled on every table
# and only the service role bypasses it.
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
# SUPABASE_SERVICE_ROLE_KEY is also accepted as an alias for SUPABASE_KEY.

# Product image uploads use Supabase Storage. This is the ONLY durable image
# store on Cloudflare Workers, which has no writable disk.
# The app creates this public bucket automatically when using the service role key.
SUPABASE_STORAGE_BUCKET="product-images"

# Never set to "true" outside a one-off brand-new-project bootstrap. It would
# restore sample products that were deliberately deleted from the catalogue.
SEED_SUPABASE_DATA="false"

# Fail loudly rather than serving a stale bundled catalogue when Supabase is
# unreachable. Always true in production, and forced true on Workers.
REQUIRE_SUPABASE="true"

# Optional. Only meaningful on a host with a persistent volume (a Railway
# volume, a mounted disk). Ignored on Cloudflare Workers, which always reads
# and writes through Supabase.
# Example Railway volume mount: /data
DATA_DIR=""

# ---------------------------------------------------------------------------
# Email / SMTP (REQUIRED for OTP login and order notifications)
# ---------------------------------------------------------------------------
# Gmail setup:
#   1. Enable 2-Factor Authentication on your Google account
#   2. Go to: myaccount.google.com/apppasswords
#   3. Create an App Password → copy the 16-char password (remove spaces)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"   # 16-char Gmail App Password
SMTP_FROM_NAME="Radha Fashions"
SMTP_FROM_EMAIL="updates@radhafashions.in"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="updates@radhafashions.in"

# Admin notification email — receives alert for every new order
ADMIN_NOTIFICATION_EMAIL="radhanarayan0709@gmail.com"

# Set to "true" to send real emails. When "false", OTP is returned in the API
# response body (dev mode only — never expose OTP in production responses).
ENABLE_REAL_NOTIFICATIONS="true"

# ---------------------------------------------------------------------------
# Gemini AI (Optional — for smart search & product recommendations)
# ---------------------------------------------------------------------------
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ---------------------------------------------------------------------------
# Razorpay Payment Gateway (Required for online payments)
# ---------------------------------------------------------------------------
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_XXXXXX
RAZORPAY_KEY_SECRET=XXXXXX

# ---------------------------------------------------------------------------
# PayU Payment Gateway (Fallback — not actively used)
# ---------------------------------------------------------------------------
PAYU_MERCHANT_KEY="YOUR_PAYU_MERCHANT_KEY"
PAYU_MERCHANT_SALT="YOUR_PAYU_MERCHANT_SALT"
PAYU_ENV="test"
PAYU_SUCCESS_URL="http://localhost:3000/api/payu/success"
PAYU_FAILURE_URL="http://localhost:3000/api/payu/failure"
PAYU_WEBHOOK_URL="http://localhost:3000/api/payu/webhook"

# ---------------------------------------------------------------------------
# Twilio SMS (Optional — for order confirmation SMS)
# ---------------------------------------------------------------------------
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_NUMBER=""            # Your Twilio number in E.164: +15017122661
TWILIO_WHATSAPP_NUMBER=""       # WhatsApp sender: whatsapp:+14155238886
