{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "dev:cf": "npm run build && wrangler dev",
    "dev:cf:remote": "npm run build && wrangler dev --remote",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:deploy:dry": "npm run build && wrangler deploy --dry-run",
    "cf:logs": "wrangler tail",
    "cf-typegen": "wrangler types",
    "test": "tsx --test tests/*.test.ts",
    "test:watch": "tsx --test --watch tests/*.test.ts",
    "smoke": "tsx scripts/smoke.mts"
  },
  "//overrides": "iconv-lite is pulled in transitively by raw-body <- body-parser <- express. 0.4.x ships a `browser` field that stubs out ./lib/streams while lib/index.js still calls it, so the Workers bundle crashes at start-up with `require_streams(...) is not a function` (cloudflare/workers-sdk#9309). 0.7.x keeps the entry point consistent, so the override pins the Workers-compatible build for Node too.",
  "overrides": {
    "iconv-lite": "^0.7.3"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@clerk/themes": "^2.4.57",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.110.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/dompurify": "^3.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.4.12",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "razorpay": "^2.9.8",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hot-toast": "^2.6.0",
    "twilio": "^6.0.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.147.0"
  }
}
